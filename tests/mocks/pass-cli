#!/usr/bin/env bash
# Mock pass-cli: replays fixtures from $OMAPASS_FIXTURES/pass-cli/<key>.{json,txt,stderr,exit,delay,ignore-term}.
# The key is the args joined with "__", with "/" and spaces replaced by "_".
# With OMAPASS_MOCK_STDIN_DIR set and stdin not a terminal, stdin is captured byte-exact to
# $OMAPASS_MOCK_STDIN_DIR/<key>.stdin (last call per key wins), and to last.stdin when
# non-empty (never to the mock log).
# With OMAPASS_MOCK_ENV_LOG set, the environment pass-cli received is appended there.
args="$*"
if [[ -n "${OMAPASS_MOCK_LOG:-}" ]]; then
  echo "pass-cli $args" >>"$OMAPASS_MOCK_LOG"
fi
if [[ -n "${OMAPASS_MOCK_ENV_LOG:-}" ]]; then
  env >>"$OMAPASS_MOCK_ENV_LOG"
fi
key=""
sep=""
for a in "$@"; do
  key="$key$sep$a"
  sep="__"
done
key="${key//\//_}"
key="${key// /_}"
if [[ -n "${OMAPASS_MOCK_STDIN_DIR:-}" && ! -t 0 ]]; then
  mkdir -p "$OMAPASS_MOCK_STDIN_DIR"
  cat >"$OMAPASS_MOCK_STDIN_DIR/$key.stdin"
  if [[ -s "$OMAPASS_MOCK_STDIN_DIR/$key.stdin" ]]; then
    cp "$OMAPASS_MOCK_STDIN_DIR/$key.stdin" "$OMAPASS_MOCK_STDIN_DIR/last.stdin"
  fi
fi
dir="${OMAPASS_FIXTURES:-}/pass-cli"
out=""
for ext in json txt; do
  if [[ -f "$dir/$key.$ext" ]]; then
    out="$dir/$key.$ext"
    break
  fi
done
if [[ -z "$out" ]]; then
  echo "mock pass-cli: no fixture for: $args" >&2
  exit 2
fi
if [[ -f "$dir/$key.ignore-term" ]]; then
  # Ignore SIGTERM, so the sleep below survives timeout and only timeout -k (SIGKILL) ends it.
  trap '' TERM
fi
if [[ -f "$dir/$key.delay" ]]; then
  d="$(tr -d '[:space:]' <"$dir/$key.delay")"
  # shellcheck disable=SC2217 # detach stdio so a killed mock leaves no orphan on the pipe
  sleep "$d" </dev/null >/dev/null 2>&1
fi
cat "$out"
if [[ -f "$dir/$key.stderr" ]]; then
  cat "$dir/$key.stderr" >&2
fi
code=0
if [[ -f "$dir/$key.exit" ]]; then
  code="$(tr -d '[:space:]' <"$dir/$key.exit")"
fi
exit "$code"
