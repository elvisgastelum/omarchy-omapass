#!/usr/bin/env bash
# Mock pass-cli: replays fixtures from $OMAPASS_FIXTURES/pass-cli/<key>.{json,txt,stderr,exit,delay,ignore-term}.
# The key is the args joined with "__", with "/" and spaces replaced by "_".
args="$*"
if [[ -n "${OMAPASS_MOCK_LOG:-}" ]]; then
  echo "pass-cli $args" >>"$OMAPASS_MOCK_LOG"
fi
key=""
sep=""
for a in "$@"; do
  key="$key$sep$a"
  sep="__"
done
key="${key//\//_}"
key="${key// /_}"
dir="${OMAPASS_FIXTURES:-}/pass-cli"
out=""
for ext in json txt; do
  if [[ -f "$dir/$key.$ext" ]]; then
    out="$dir/$key.$ext"
    break
  fi
done
if [[ -z "$out" ]]; then
  echo "mock pass-cli: no fixture for: $args" >&2
  exit 2
fi
if [[ -f "$dir/$key.ignore-term" ]]; then
  # Ignore SIGTERM, so the sleep below survives timeout and only timeout -k (SIGKILL) ends it.
  trap '' TERM
fi
if [[ -f "$dir/$key.delay" ]]; then
  d="$(tr -d '[:space:]' <"$dir/$key.delay")"
  # shellcheck disable=SC2217 # detach stdio so a killed mock leaves no orphan on the pipe
  sleep "$d" </dev/null >/dev/null 2>&1
fi
cat "$out"
if [[ -f "$dir/$key.stderr" ]]; then
  cat "$dir/$key.stderr" >&2
fi
code=0
if [[ -f "$dir/$key.exit" ]]; then
  code="$(tr -d '[:space:]' <"$dir/$key.exit")"
fi
exit "$code"
